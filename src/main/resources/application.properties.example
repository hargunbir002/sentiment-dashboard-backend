# Copy this file to application.properties and fill in your own values.
# application.properties itself is listed in .gitignore and must never be committed.

spring.application.name=sentiment-dashboard

# --- Database (MySQL 8) ---
spring.datasource.url=jdbc:mysql://localhost:3306/sentiment_dashboard
spring.datasource.username=root
spring.datasource.password=YOUR_PASSWORD

# --- JPA / Hibernate ---
# Tables must already exist: run docs/schema.sql first.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# --- JWT ---
# Use a long random string (at least 32 characters).
app.jwt.secret=YOUR_SECRET
app.jwt.expiry-ms=86400000

# --- CSV upload limits ---
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
